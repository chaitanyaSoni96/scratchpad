{{if not .Cards}}
<div class="empty">
  {{if .Folder}}
  <p>No artifacts left in <code>{{.Folder}}</code>.</p>
  <p><a href="/">← back to scratchpad</a></p>
  {{else}}
  <p>Nothing here yet.</p>
  <p>Publish an artifact with the <code>scratchpad</code> CLI, or drop an
     <code>index.html</code> into a folder under <code>~/.scratchpad</code>.</p>
  {{end}}
</div>
{{else}}
<div class="grid">
  {{range .Cards}}
  {{if eq .Kind "project"}}
  {{/* ids let the morph swap recognize unchanged cards and leave their
       preview iframes untouched; hrefs are unique so they double as keys */}}
  {{/* an article, not one big anchor: the tile carries an unwatch button when
       the folder is a watch link, and a button may not nest inside a link */}}
  <article class="card project-card" id="card{{.Href}}">
    <a class="preview" href="{{.Href}}">
      {{if .Preview.Dir}}
      {{/* ?v= makes edits show up under morph swaps: a changed modtime is an
           attribute change, so only that card's iframe reloads */}}
      {{/* onload lives inline, not in delegated JS: it must fire in every
           engine and survive morph swaps, or the preview stays hidden.
           No loading=lazy — an engine may never load a hidden lazy frame,
           and hidden-until-loaded would then deadlock. */}}
      <iframe src="/a/{{.Preview.RelPath}}/?v={{.Preview.ModTime.Unix}}" onload="this.classList.add('loaded')" onerror="this.classList.add('loaded')" sandbox="allow-scripts" scrolling="no" title="{{.Label}} preview" tabindex="-1"></iframe>
      {{else}}
      <div class="doc-folder">▤</div>
      {{end}}
    </a>
    <div class="meta">
      <div class="titles"><a class="name" href="{{.Href}}">{{.Label}}/</a></div>
      <div class="row">
        {{if .Preview.Dir}}<time>{{.Preview.ModTime.Format "Jan 2 15:04"}}</time>{{else}}<span></span>{{end}}
        <span class="row-right">
          <span class="badge">{{.Count}} {{.Unit}}</span>
          {{with .Unwatch}}
          <button class="delete" hx-delete="/watch/{{.Path}}"
                  hx-confirm="{{.Confirm}}"
                  hx-target="closest .card" hx-swap="outerHTML"
                  title="watched folder — removes the link, keeps the source">unwatch</button>
          {{end}}
        </span>
      </div>
    </div>
  </article>
  {{else if eq .Kind "page"}}
  <article class="card" id="card{{.PageHref}}">
    <div class="preview" hx-get="{{.ViewerHref}}" hx-target="#viewer" title="open {{.Label}}">
      <iframe src="{{.PageHref}}?v={{.PageMod.Unix}}" onload="this.classList.add('loaded')" onerror="this.classList.add('loaded')" sandbox="allow-scripts" scrolling="no" title="{{.Label}} preview" tabindex="-1"></iframe>
    </div>
    <div class="meta">
      <div class="titles">
        <button class="name" hx-get="{{.ViewerHref}}" hx-target="#viewer">{{.Label}}</button>
        {{if .PageIsDoc}}<span class="doctag">md</span>{{end}}
        <a class="ext" href="{{.PageHref}}" target="_blank" rel="noopener" title="open in new tab">↗</a>
      </div>
      <div class="row">
        <time>{{.PageMod.Format "Jan 2 15:04"}}</time>
        <span class="row-right"><span class="fsize">{{size .PageSize}}</span></span>
      </div>
    </div>
  </article>
  {{else}}
  <article class="card" id="card/a/{{.Artifact.RelPath}}">
    <div class="preview" hx-get="/fragments/viewer/{{.Artifact.RelPath}}" hx-target="#viewer" title="open {{.Artifact.Name}}">
      <iframe src="/a/{{.Artifact.RelPath}}/?v={{.Artifact.ModTime.Unix}}" onload="this.classList.add('loaded')" onerror="this.classList.add('loaded')" sandbox="allow-scripts" scrolling="no" title="{{.Artifact.Name}} preview" tabindex="-1"></iframe>
    </div>
    <div class="meta">
      <div class="titles">
        {{if .PrefixLabel}}<a class="project" href="{{.PrefixHref}}" title="open folder {{.PrefixLabel}}">{{.PrefixLabel}}/</a>{{end}}
        <button class="name" hx-get="/fragments/viewer/{{.Artifact.RelPath}}" hx-target="#viewer">{{.Artifact.Name}}</button>
        <a class="ext" href="/a/{{.Artifact.RelPath}}/" target="_blank" rel="noopener" title="open in new tab">↗</a>
      </div>
      <div class="row">
        <time>{{.Artifact.ModTime.Format "Jan 2 15:04"}}</time>
        <span class="row-right">
          <span class="fsize">{{size .Artifact.Size}}</span>
          {{if .Unwatch}}
          {{if ne .Unwatch.Path .Artifact.RelPath}}
          <span class="linked" title="inside watched folder {{.Unwatch.Path}} — files live at the source">watched</span>
          {{end}}
          <button class="delete" hx-delete="/watch/{{.Unwatch.Path}}"
                  hx-confirm="{{.Unwatch.Confirm}}"
                  hx-target="closest .card" hx-swap="outerHTML"
                  title="removes the link, keeps the source folder">unwatch</button>
          {{else}}
          <button class="delete" hx-delete="/a/{{.Artifact.RelPath}}"
                  hx-confirm="Delete {{.Artifact.RelPath}}?"
                  hx-target="closest .card" hx-swap="outerHTML">delete</button>
          {{end}}
        </span>
      </div>
    </div>
  </article>
  {{end}}
  {{end}}
</div>
{{end}}
