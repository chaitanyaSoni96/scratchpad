{{if .Items}}<div class="sib-list">
  {{- range .Items -}}
  {{if .Current}}<span class="sib current">{{.Name}}</span>
  {{- else if .Viewer}}<button class="sib" hx-get="{{.Href}}" hx-target="#viewer">{{.Name}}</button>
  {{- else}}<a class="sib" href="{{.Href}}">{{.Name}}/</a>{{end}}
  {{- end -}}
</div>{{end}}
