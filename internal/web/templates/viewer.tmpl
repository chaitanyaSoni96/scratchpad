<div class="overlay" id="overlay">
  <header>
    <h1><a href="/">scratchpad</a>{{range .Crumbs}} <span class="crumb-sep">/</span> <a class="crumb" href="{{.Href}}">{{.Name}}</a>{{end}} <span class="crumb-sep">/</span> <span class="crumb">{{.Title}}</span></h1>
    <p class="tagline">artifact in <code>~/.scratchpad/{{.Path}}</code>, live</p>
    <div class="overlay-actions">
      <span class="fsize">{{size .Size}}</span>
      <a href="{{.URL}}" target="_blank" rel="noopener" title="open in new tab">↗ tab</a>
      <button class="close" title="close (Esc)"
              hx-on:click="htmx.find('#viewer').innerHTML=''">✕</button>
    </div>
  </header>
  <!-- Deliberate open action: same trust as the open-in-tab link, so
       same-origin (localStorage etc.) is allowed; top-navigation stays
       blocked so the artifact can't navigate the scratchpad page away. -->
  <iframe src="{{.URL}}" title="{{.Title}}"
          sandbox="allow-scripts allow-same-origin allow-forms allow-modals allow-popups allow-downloads"></iframe>
</div>
<script>
  (function () {
    function esc(e) {
      if (e.key !== "Escape") return;
      document.removeEventListener("keydown", esc);
      var v = document.getElementById("viewer");
      if (v) v.innerHTML = "";
    }
    document.addEventListener("keydown", esc);
    // Focus moves into the artifact once it's clicked, so listen inside the
    // (same-origin) viewer iframe too or Esc would stop working.
    var frame = document.querySelector("#overlay iframe");
    frame.addEventListener("load", function () {
      try { frame.contentWindow.addEventListener("keydown", esc); } catch (_) {}
    });
  })();
</script>
