<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{if .Folder}}{{.Folder}} · scratchpad{{else}}scratchpad{{end}}</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/htmx.min.js"></script>
  <script src="/static/sse.js"></script>
</head>
<body hx-ext="sse" sse-connect="/events">
  <header>
    <h1><a href="/">scratchpad</a>{{range .Crumbs}} <span class="crumb-sep">/</span> {{if .Last}}<span class="crumb">{{.Name}}</span>{{else}}<a class="crumb" href="{{.Href}}">{{.Name}}</a>{{end}}{{end}}</h1>
    <p class="tagline">artifacts in <code>~/.scratchpad{{if .Folder}}/{{.Folder}}{{end}}</code>, live</p>
  </header>
  <main id="list" hx-get="/fragments/list{{if .Folder}}?project={{.Folder}}{{end}}" hx-trigger="load, sse:change"></main>
  <div id="viewer"></div>
</body>
</html>
